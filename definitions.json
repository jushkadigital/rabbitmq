{
  "rabbit_version": "3.13.0",
  "rabbitmq_vhosts": [],
  "rabbitmq_permissions": [],
  "rabbitmq_parameters": [],
  "rabbitmq_global_parameters": [],
  "rabbitmq_policies": [
    {
      "vhost": "/",
      "name": "queue-limits",
      "pattern": ".*",
      "apply-to": "queues",
      "definition": {
        "max-length": 100000,
        "message-ttl": 86400000,
        "overflow": "reject-publish"
      },
      "priority": 0
    }
  ]
}
